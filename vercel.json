{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), fullscreen=(self), screen-wake-lock=(self)"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/lgp.ts": {
      "maxDuration": 60
    },
    "api/signs.ts": {
      "maxDuration": 15
    },
    "api/admin.ts": {
      "maxDuration": 60
    },
    "api/resolve.ts": {
      "maxDuration": 30
    },
    "api/lexicon.ts": {
      "maxDuration": 15
    }
  }
}